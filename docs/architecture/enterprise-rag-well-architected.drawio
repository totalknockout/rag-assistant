tSize=11;fontColor=#232F3E;" vertex="1" parent="ing"><mxGeometry x="780.0" y="230.0" width="64" height="64" as="geometry"/></mxCell><mxCell id="rerank" value="Amazon Bedrock Rerank API&lt;br&gt;Cohere Rerank 3.5" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#01A88D;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.bedrock;fontSize=11;fontColor=#232F3E;" vertex="1" parent="fra"><mxGeometry x="163.0" y="60.0" width="64" height="64" as="geometry"/></mxCell><mxCell id="franote" value="Not offered in London; called over HTTPS through the NAT gateways." style="text;html=1;whiteSpace=wrap;fontSize=10;fontColor=#545B64;align=center;verticalAlign=top;fontStyle=0;spacing=2;" vertex="1" parent="fra"><mxGeometry x="20.0" y="170.0" width="350" height="40" as="geometry"/></mxCell><mxCell id="drs3" value="S3 replica bucket&lt;br&gt;Cross-Region Replication" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#7AA116;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.bucket;fontSize=11;fontColor=#232F3E;" vertex="1" parent="dub"><mxGeometry x="70.0" y="70.0" width="60" height="62" as="geometry"/></mxCell><mxCell id="drkms" value="KMS multi-Region&lt;br&gt;replica keys" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.key_management_service;fontSize=11;fontColor=#232F3E;" vertex="1" parent="dub"><mxGeometry x="258.0" y="70.0" width="64" height="64" as="geometry"/></mxCell><mxCell id="draoss" value="OpenSearch Serverless&lt;br&gt;rebuilt from S3 on failover" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.elasticsearch_service;fontSize=11;fontColor=#232F3E;opacity=45;textOpacity=100;" vertex="1" parent="dub"><mxGeometry x="68.0" y="270.0" width="64" height="64" as="geometry"/></mxCell><mxCell id="drapi" value="API Gateway + Lambda&lt;br&gt;deployed by Terraform" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.api_gateway;fontSize=11;fontColor=#232F3E;opacity=45;textOpacity=100;" vertex="1" parent="dub"><mxGeometry x="258.0" y="270.0" width="64" height="64" as="geometry"/></mxCell><mxCell id="drcog" value="Cognito&lt;br&gt;user recovery plan" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cognito;fontSize=11;fontColor=#232F3E;opacity=45;textOpacity=100;" vertex="1" parent="dub"><mxGeometry x="68.0" y="470.0" width="64" height="64" as="geometry"/></mxCell><mxCell id="drbed" value="Bedrock&lt;br&gt;model availability checked" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#01A88D;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.bedrock;fontSize=11;fontColor=#232F3E;opacity=45;textOpacity=100;" vertex="1" parent="dub"><mxGeometry x="258.0" y="470.0" width="64" height="64" as="geometry"/></mxCell><mxCell id="drnote" value="Faded resources are created only at failover, from the same Terraform modules. Route 53 failover records switch traffic once the stack is healthy. RTO and RPO are defined and rehearsed." style="text;html=1;whiteSpace=wrap;fontSize=10;fontColor=#545B64;align=left;verticalAlign=top;fontStyle=0;spacing=2;" vertex="1" parent="dub"><mxGeometry x="20.0" y="640.0" width="350" height="90" as="geometry"/></mxCell><mxCell id="pq" value="&lt;div style=&#x27;font-size:14px;font-weight:bold;margin-bottom:6px&#x27;&gt;Question flow&lt;/div&gt;&lt;table style=&#x27;border-collapse:collapse&#x27;&gt;&lt;tr&gt;&lt;td style=&#x27;vertical-align:top;padding:3px 8px 3px 0&#x27;&gt;&lt;span style=&#x27;display:inline-block;width:18px;height:18px;border-radius:9px;background:#232F3E;color:#fff;text-align:center;font-weight:bold;line-height:18px&#x27;&gt;1&lt;/span&gt;&lt;/td&gt;&lt;td style=&#x27;padding:3px 0&#x27;&gt;Staff resolve the app through Route 53 and load the React site from CloudFront; AWS WAF inspects every request.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#x27;vertical-align:top;padding:3px 8px 3px 0&#x27;&gt;&lt;span style=&#x27;display:inline-block;width:18px;height:18px;border-radius:9px;background:#232F3E;color:#fff;text-align:center;font-weight:bold;line-height:18px&#x27;&gt;2&lt;/span&gt;&lt;/td&gt;&lt;td style=&#x27;padding:3px 0&#x27;&gt;They sign in with Cognito (managed login, PKCE, MFA). The token carries the user&#x27;s &lt;i&gt;cognito:groups&lt;/i&gt;.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#x27;vertical-align:top;padding:3px 8px 3px 0&#x27;&gt;&lt;span style=&#x27;display:inline-block;width:18px;height:18px;border-radius:9px;background:#232F3E;color:#fff;text-align:center;font-weight:bold;line-height:18px&#x27;&gt;3&lt;/span&gt;&lt;/td&gt;&lt;td style=&#x27;padding:3px 0&#x27;&gt;The browser calls &lt;i&gt;/api/chat&lt;/i&gt; through CloudFront to the Regional REST API, which streams the response.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#x27;vertical-align:top;padding:3px 8px 3px 0&#x27;&gt;&lt;span style=&#x27;display:inline-block;width:18px;height:18px;border-radius:9px;background:#232F3E;color:#fff;text-align:center;font-weight:bold;line-height:18px&#x27;&gt;4&lt;/span&gt;&lt;/td&gt;&lt;td style=&#x27;padding:3px 0&#x27;&gt;The Cognito authoriser checks the token&#x27;s signature, issuer, audience and expiry.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#x27;vertical-align:top;padding:3px 8px 3px 0&#x27;&gt;&lt;span style=&#x27;display:inline-block;width:18px;height:18px;border-radius:9px;background:#232F3E;color:#fff;text-align:center;font-weight:bold;line-height:18px&#x27;&gt;5&lt;/span&gt;&lt;/td&gt;&lt;td style=&#x27;padding:3px 0&#x27;&gt;API Gateway invokes the Query Lambda, which has ENIs in the private app subnet of each AZ.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#x27;vertical-align:top;padding:3px 8px 3px 0&#x27;&gt;&lt;span style=&#x27;display:inline-block;width:18px;height:18px;border-radius:9px;background:#232F3E;color:#fff;text-align:center;font-weight:bold;line-height:18px&#x27;&gt;6&lt;/span&gt;&lt;/td&gt;&lt;td style=&#x27;padding:3px 0&#x27;&gt;Through interface endpoints, the Lambda screens the question with Guardrails and embeds it with Titan V2.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#x27;vertical-align:top;padding:3px 8px 3px 0&#x27;&gt;&lt;span style=&#x27;display:inline-block;width:18px;height:18px;border-radius:9px;background:#232F3E;color:#fff;text-align:center;font-weight:bold;line-height:18px&#x27;&gt;7&lt;/span&gt;&lt;/td&gt;&lt;td style=&#x27;padding:3px 0&#x27;&gt;A hybrid (BM25 + k-NN) query runs on OpenSearch Serverless with a mandatory &lt;i&gt;allowed_groups&lt;/i&gt; filter built from the verified token.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#x27;vertical-align:top;padding:3px 8px 3px 0&#x27;&gt;&lt;span style=&#x27;display:inline-block;width:18px;height:18px;border-radius:9px;background:#232F3E;color:#fff;text-align:center;font-weight:bold;line-height:18px&#x27;&gt;8&lt;/span&gt;&lt;/td&gt;&lt;td style=&#x27;padding:3px 0&#x27;&gt;About 30 candidates go to Bedrock Rerank in Frankfurt over HTTPS via the AZ&#x27;s NAT gateway; the best 5 to 8 are kept.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#x27;vertical-align:top;padding:3px 8px 3px 0&#x27;&gt;&lt;span style=&#x27;display:inline-block;width:18px;height:18px;border-radius:9px;background:#232F3E;color:#fff;text-align:center;font-weight:bold;line-height:18px&#x27;&gt;9&lt;/span&gt;&lt;/td&gt;&lt;td style=&#x27;padding:3px 0&#x27;&gt;Claude writes a cited answer, a grounding check runs, and the answer streams back to the browser.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#AAB7B8;align=left;verticalAlign=top;spacing=12;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="230.0" y="1780.0" width="780" height="280" as="geometry"/></mxCell><mxCell id="pi" value="&lt;div style=&#x27;font-size:14px;font-weight:bold;margin-bottom:6px&#x27;&gt;Document ingestion flow&lt;/div&gt;&lt;table style=&#x27;border-collapse:collapse&#x27;&gt;&lt;tr&gt;&lt;td style=&#x27;vertical-align:top;padding:3px 8px 3px 0&#x27;&gt;&lt;span style=&#x27;display:inline-block;width:18px;height:18px;border-radius:9px;background:#D45B07;color:#fff;text-align:center;font-weight:bold;line-height:18px&#x27;&gt;A&lt;/span&gt;&lt;/td&gt;&lt;td style=&#x27;padding:3px 0&#x27;&gt;Document owners upload through a short-lived presigned URL; a sidecar file sets the document&#x27;s allowed groups.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#x27;vertical-align:top;padding:3px 8px 3px 0&#x27;&gt;&lt;span style=&#x27;display:inline-block;width:18px;height:18px;border-radius:9px;background:#D45B07;color:#fff;text-align:center;font-weight:bold;line-height:18px&#x27;&gt;B&lt;/span&gt;&lt;/td&gt;&lt;td style=&#x27;padding:3px 0&#x27;&gt;GuardDuty Malware Protection scans each new object; objects with threats are routed to the quarantine bucket.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#x27;vertical-align:top;padding:3px 8px 3px 0&#x27;&gt;&lt;span style=&#x27;display:inline-block;width:18px;height:18px;border-radius:9px;background:#D45B07;color:#fff;text-align:center;font-weight:bold;line-height:18px&#x27;&gt;C&lt;/span&gt;&lt;/td&gt;&lt;td style=&#x27;padding:3px 0&#x27;&gt;Clean-scan events go from EventBridge to SQS, which absorbs bursts and retries; repeat failures land in the DLQ.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#x27;vertical-align:top;padding:3px 8px 3px 0&#x27;&gt;&lt;span style=&#x27;display:inline-block;width:18px;height:18px;border-radius:9px;background:#D45B07;color:#fff;text-align:center;font-weight:bold;line-height:18px&#x27;&gt;D&lt;/span&gt;&lt;/td&gt;&lt;td style=&#x27;padding:3px 0&#x27;&gt;The Ingest Lambda, with capped concurrency, skips documents whose content hash is unchanged in the DynamoDB registry.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#x27;vertical-align:top;padding:3px 8px 3px 0&#x27;&gt;&lt;span style=&#x27;display:inline-block;width:18px;height:18px;border-radius:9px;background:#D45B07;color:#fff;text-align:center;font-weight:bold;line-height:18px&#x27;&gt;E&lt;/span&gt;&lt;/td&gt;&lt;td style=&#x27;padding:3px 0&#x27;&gt;It extracts text (Textract for scanned PDFs only), chunks it and stores the processed artefacts in S3.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#x27;vertical-align:top;padding:3px 8px 3px 0&#x27;&gt;&lt;span style=&#x27;display:inline-block;width:18px;height:18px;border-radius:9px;background:#D45B07;color:#fff;text-align:center;font-weight:bold;line-height:18px&#x27;&gt;F&lt;/span&gt;&lt;/td&gt;&lt;td style=&#x27;padding:3px 0&#x27;&gt;Chunks are embedded with Titan V2 and indexed in OpenSearch Serverless with their allowed groups. Originals replicate to eu-west-1.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#AAB7B8;align=left;verticalAlign=top;spacing=12;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1030.0" y="1780.0" width="760" height="280" as="geometry"/></mxCell><mxCell id="pl" value="&lt;div style=&#x27;font-size:14px;font-weight:bold;margin-bottom:6px&#x27;&gt;Legend and notes&lt;/div&gt;&lt;table&gt;&lt;tr&gt;&lt;td style=&#x27;padding:4px 10px 4px 0&#x27;&gt;&lt;div style=&#x27;width:46px;border-top:2px solid #232F3E&#x27;&gt;&lt;/div&gt;&lt;/td&gt;&lt;td&gt;Question path (user request and response)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#x27;padding:4px 10px 4px 0&#x27;&gt;&lt;div style=&#x27;width:46px;border-top:2px solid #D45B07&#x27;&gt;&lt;/div&gt;&lt;/td&gt;&lt;td&gt;Document ingestion path&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#x27;padding:4px 10px 4px 0&#x27;&gt;&lt;div style=&#x27;width:46px;border-top:2px solid #01A88D&#x27;&gt;&lt;/div&gt;&lt;/td&gt;&lt;td&gt;Private connectivity: interface and gateway VPC endpoints&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#x27;padding:4px 10px 4px 0&#x27;&gt;&lt;div style=&#x27;width:46px;border-top:2px dashed #3F8624&#x27;&gt;&lt;/div&gt;&lt;/td&gt;&lt;td&gt;Outbound HTTPS through NAT gateway and internet gateway&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#x27;padding:4px 10px 4px 0&#x27;&gt;&lt;div style=&#x27;width:46px;border-top:2px dashed #8C4FFF&#x27;&gt;&lt;/div&gt;&lt;/td&gt;&lt;td&gt;Cross-Region replication to the DR Region&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;div style=&#x27;margin-top:8px&#x27;&gt;Coloured tags such as &lt;b&gt;SEC 3&lt;/b&gt; refer to the Well-Architected notes below. Lambda functions are Regional; the icons in each AZ are the functions&#x27; network interfaces. S3, SQS, EventBridge, DynamoDB, Bedrock and OpenSearch Serverless are Regional services outside the VPC. Faded icons are provisioned only during failover.&lt;/div&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#AAB7B8;align=left;verticalAlign=top;spacing=12;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1810.0" y="1780.0" width="790" height="280" as="geometry"/></mxCell><mxCell id="wa_title" value="AWS Well-Architected Framework: how this design applies each pillar" style="text;html=1;fontSize=16;fontStyle=1;fontColor=#232F3E;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="230.0" y="2080.0" width="1600" height="30" as="geometry"/></mxCell><mxCell id="wa_OE" value="&lt;div style=&#x27;background:#4B5A6B;color:#fff;font-weight:bold;font-size:13px;padding:6px 8px;margin:-12px -12px 8px -12px;border-radius:4px 4px 0 0&#x27;&gt;Operational excellence&lt;/div&gt;&lt;table style=&#x27;border-collapse:collapse&#x27;&gt;&lt;tr&gt;&lt;td style=&#x27;vertical-align:top;padding:4px 6px 4px 0;white-space:nowrap&#x27;&gt;&lt;span style=&#x27;background:#4B5A6B;color:#fff;font-weight:bold;border-radius:8px;padding:1px 6px;font-size:10px&#x27;&gt;OE 1&lt;/span&gt;&lt;/td&gt;&lt;td style=&#x27;padding:4px 0&#x27;&gt;Everything as code: Terraform modules, GitHub Actions with OIDC, a plan on every PR and an approval-gated apply.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#x27;vertical-align:top;padding:4px 6px 4px 0;white-space:nowrap&#x27;&gt;&lt;span style=&#x27;background:#4B5A6B;color:#fff;font-weight:bold;border-radius:8px;padding:1px 6px;font-size:10px&#x27;&gt;OE 2&lt;/span&gt;&lt;/td&gt;&lt;td style=&#x27;padding:4px 0&#x27;&gt;Every request observable: structured logs, X-Ray traces, CloudWatch dashboards and alarms on DLQ depth, p95 latency and guardrail spikes.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#x27;vertical-align:top;padding:4px 6px 4px 0;white-space:nowrap&#x27;&gt;&lt;span style=&#x27;background:#4B5A6B;color:#fff;font-weight:bold;border-radius:8px;padding:1px 6px;font-size:10px&#x27;&gt;OE 3&lt;/span&gt;&lt;/td&gt;&lt;td style=&#x27;padding:4px 0&#x27;&gt;Retrieval, answer-quality and red-team evaluations run in CI as release gates; runbooks cover failover and DLQ replay.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#AAB7B8;strokeColor=#4B5A6B;align=left;verticalAlign=top;spacing=12;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="230.0" y="2120.0" width="383.3333333333333" height="330" as="geometry"/></mxCell><mxCell id="wa_SEC" value="&lt;div style=&#x27;background:#C7254E;color:#fff;font-weight:bold;font-size:13px;padding:6px 8px;margin:-12px -12px 8px -12px;border-radius:4px 4px 0 0&#x27;&gt;Security&lt;/div&gt;&lt;table style=&#x27;border-collapse:collapse&#x27;&gt;&lt;tr&gt;&lt;td style=&#x27;vertical-align:top;padding:4px 6px 4px 0;white-space:nowrap&#x27;&gt;&lt;span style=&#x27;background:#C7254E;color:#fff;font-weight:bold;border-radius:8px;padding:1px 6px;font-size:10px&#x27;&gt;SEC 1&lt;/span&gt;&lt;/td&gt;&lt;td style=&#x27;padding:4px 0&#x27;&gt;Edge: WAF managed rules and rate limits on CloudFront, TLS from ACM, S3 site private behind OAC.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#x27;vertical-align:top;padding:4px 6px 4px 0;white-space:nowrap&#x27;&gt;&lt;span style=&#x27;background:#C7254E;color:#fff;font-weight:bold;border-radius:8px;padding:1px 6px;font-size:10px&#x27;&gt;SEC 2&lt;/span&gt;&lt;/td&gt;&lt;td style=&#x27;padding:4px 0&#x27;&gt;Identity: Cognito with MFA, JWTs validated by API Gateway, groups read only from verified claims.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#x27;vertical-align:top;padding:4px 6px 4px 0;white-space:nowrap&#x27;&gt;&lt;span style=&#x27;background:#C7254E;color:#fff;font-weight:bold;border-radius:8px;padding:1px 6px;font-size:10px&#x27;&gt;SEC 3&lt;/span&gt;&lt;/td&gt;&lt;td style=&#x27;padding:4px 0&#x27;&gt;Isolation: a mandatory &lt;i&gt;allowed_groups&lt;/i&gt; filter on every vector and keyword query; default deny.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#x27;vertical-align:top;padding:4px 6px 4px 0;white-space:nowrap&#x27;&gt;&lt;span style=&#x27;background:#C7254E;color:#fff;font-weight:bold;border-radius:8px;padding:1px 6px;font-size:10px&#x27;&gt;SEC 4&lt;/span&gt;&lt;/td&gt;&lt;td style=&#x27;padding:4px 0&#x27;&gt;Network: Lambdas in private subnets; Bedrock, OpenSearch and Textract reached through endpoints; one security group per role.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#x27;vertical-align:top;padding:4px 6px 4px 0;white-space:nowrap&#x27;&gt;&lt;span style=&#x27;background:#C7254E;color:#fff;font-weight:bold;border-radius:8px;padding:1px 6px;font-size:10px&#x27;&gt;SEC 5&lt;/span&gt;&lt;/td&gt;&lt;td style=&#x27;padding:4px 0&#x27;&gt;Encryption and least privilege: KMS keys for S3, SQS, DynamoDB, OpenSearch and logs; one IAM role per function.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#x27;vertical-align:top;padding:4px 6px 4px 0;white-space:nowrap&#x27;&gt;&lt;span style=&#x27;background:#C7254E;color:#fff;font-weight:bold;border-radius:8px;padding:1px 6px;font-size:10px&#x27;&gt;SEC 6&lt;/span&gt;&lt;/td&gt;&lt;td style=&#x27;padding:4px 0&#x27;&gt;Untrusted content: malware scan and quarantine before indexing; Guardrails for prompt attacks, PII and grounding.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#x27;vertical-align:top;padding:4px 6px 4px 0;white-space:nowrap&#x27;&gt;&lt;span style=&#x27;background:#C7254E;color:#fff;font-weight:bold;border-radius:8px;padding:1px 6px;font-size:10px&#x27;&gt;SEC 7&lt;/span&gt;&lt;/td&gt;&lt;td style=&#x27;padding:4px 0&#x27;&gt;Detection and audit: CloudTrail, GuardDuty, Security Hub, AWS Config and VPC Flow Logs.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#AAB7B8;strokeColor=#C7254E;align=left;verticalAlign=top;spacing=12;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="627.3" y="2120.0" width="383.3333333333333" height="330" as="geometry"/></mxCell><mxCell id="wa_REL" value="&lt;div style=&#x27;background:#1565C0;color:#fff;font-weight:bold;font-size:13px;padding:6px 8px;margin:-12px -12px 8px -12px;border-radius:4px 4px 0 0&#x27;&gt;Reliability&lt;/div&gt;&lt;table style=&#x27;border-collapse:collapse&#x27;&gt;&lt;tr&gt;&lt;td style=&#x27;vertical-align:top;padding:4px 6px 4px 0;white-space:nowrap&#x27;&gt;&lt;span style=&#x27;background:#1565C0;color:#fff;font-weight:bold;border-radius:8px;padding:1px 6px;font-size:10px&#x27;&gt;REL 1&lt;/span&gt;&lt;/td&gt;&lt;td style=&#x27;padding:4px 0&#x27;&gt;Three AZs, each with its own NAT gateway and endpoint interfaces, in front of Regional managed services.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#x27;vertical-align:top;padding:4px 6px 4px 0;white-space:nowrap&#x27;&gt;&lt;span style=&#x27;background:#1565C0;color:#fff;font-weight:bold;border-radius:8px;padding:1px 6px;font-size:10px&#x27;&gt;REL 2&lt;/span&gt;&lt;/td&gt;&lt;td style=&#x27;padding:4px 0&#x27;&gt;Decoupled ingestion: SQS buffering, retries, a DLQ and idempotent processing through the registry.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#x27;vertical-align:top;padding:4px 6px 4px 0;white-space:nowrap&#x27;&gt;&lt;span style=&#x27;background:#1565C0;color:#fff;font-weight:bold;border-radius:8px;padding:1px 6px;font-size:10px&#x27;&gt;REL 3&lt;/span&gt;&lt;/td&gt;&lt;td style=&#x27;padding:4px 0&#x27;&gt;Pilot-light DR in eu-west-1: S3 replication, multi-Region KMS keys, Terraform redeploy, index rebuild, Route 53 failover; RTO and RPO tested.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#AAB7B8;strokeColor=#1565C0;align=left;verticalAlign=top;spacing=12;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1024.7" y="2120.0" width="383.3333333333333" height="330" as="geometry"/></mxCell><mxCell id="wa_PERF" value="&lt;div style=&#x27;background:#7B1FA2;color:#fff;font-weight:bold;font-size:13px;padding:6px 8px;margin:-12px -12px 8px -12px;border-radius:4px 4px 0 0&#x27;&gt;Performance efficiency&lt;/div&gt;&lt;table style=&#x27;border-collapse:collapse&#x27;&gt;&lt;tr&gt;&lt;td style=&#x27;vertical-align:top;padding:4px 6px 4px 0;white-space:nowrap&#x27;&gt;&lt;span style=&#x27;background:#7B1FA2;color:#fff;font-weight:bold;border-radius:8px;padding:1px 6px;font-size:10px&#x27;&gt;PERF 1&lt;/span&gt;&lt;/td&gt;&lt;td style=&#x27;padding:4px 0&#x27;&gt;Serverless services scale with demand; OpenSearch Serverless adds compute units automatically.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#x27;vertical-align:top;padding:4px 6px 4px 0;white-space:nowrap&#x27;&gt;&lt;span style=&#x27;background:#7B1FA2;color:#fff;font-weight:bold;border-radius:8px;padding:1px 6px;font-size:10px&#x27;&gt;PERF 2&lt;/span&gt;&lt;/td&gt;&lt;td style=&#x27;padding:4px 0&#x27;&gt;Hybrid retrieval of about 30 candidates, reranked to the best 5 to 8; answers stream to cut time to first token.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#x27;vertical-align:top;padding:4px 6px 4px 0;white-space:nowrap&#x27;&gt;&lt;span style=&#x27;background:#7B1FA2;color:#fff;font-weight:bold;border-radius:8px;padding:1px 6px;font-size:10px&#x27;&gt;PERF 3&lt;/span&gt;&lt;/td&gt;&lt;td style=&#x27;padding:4px 0&#x27;&gt;CloudFront serves the static front end from the edge.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#AAB7B8;strokeColor=#7B1FA2;align=left;verticalAlign=top;spacing=12;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1422.0" y="2120.0" width="383.3333333333333" height="330" as="geometry"/></mxCell><mxCell id="wa_COST" value="&lt;div style=&#x27;background:#D35400;color:#fff;font-weight:bold;font-size:13px;padding:6px 8px;margin:-12px -12px 8px -12px;border-radius:4px 4px 0 0&#x27;&gt;Cost optimisation&lt;/div&gt;&lt;table style=&#x27;border-collapse:collapse&#x27;&gt;&lt;tr&gt;&lt;td style=&#x27;vertical-align:top;padding:4px 6px 4px 0;white-space:nowrap&#x27;&gt;&lt;span style=&#x27;background:#D35400;color:#fff;font-weight:bold;border-radius:8px;padding:1px 6px;font-size:10px&#x27;&gt;COST 1&lt;/span&gt;&lt;/td&gt;&lt;td style=&#x27;padding:4px 0&#x27;&gt;Pay per use: NextGen OpenSearch collections scale to zero when idle; Lambda, Bedrock and SQS bill per request.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#x27;vertical-align:top;padding:4px 6px 4px 0;white-space:nowrap&#x27;&gt;&lt;span style=&#x27;background:#D35400;color:#fff;font-weight:bold;border-radius:8px;padding:1px 6px;font-size:10px&#x27;&gt;COST 2&lt;/span&gt;&lt;/td&gt;&lt;td style=&#x27;padding:4px 0&#x27;&gt;Free S3 and DynamoDB gateway endpoints; NAT kept only for cross-Region rerank (a single NAT gateway is enough in dev).&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#x27;vertical-align:top;padding:4px 6px 4px 0;white-space:nowrap&#x27;&gt;&lt;span style=&#x27;background:#D35400;color:#fff;font-weight:bold;border-radius:8px;padding:1px 6px;font-size:10px&#x27;&gt;COST 3&lt;/span&gt;&lt;/td&gt;&lt;td style=&#x27;padding:4px 0&#x27;&gt;Textract only for scanned PDFs; AWS Budgets alerts; 14 to 30 day log retention; Cost Explorer by tag.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#AAB7B8;strokeColor=#D35400;align=left;verticalAlign=top;spacing=12;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1819.3" y="2120.0" width="383.3333333333333" height="330" as="geometry"/></mxCell><mxCell id="wa_SUS" value="&lt;div style=&#x27;background:#2E7D32;color:#fff;font-weight:bold;font-size:13px;padding:6px 8px;margin:-12px -12px 8px -12px;border-radius:4px 4px 0 0&#x27;&gt;Sustainability&lt;/div&gt;&lt;table style=&#x27;border-collapse:collapse&#x27;&gt;&lt;tr&gt;&lt;td style=&#x27;vertical-align:top;padding:4px 6px 4px 0;white-space:nowrap&#x27;&gt;&lt;span style=&#x27;background:#2E7D32;color:#fff;font-weight:bold;border-radius:8px;padding:1px 6px;font-size:10px&#x27;&gt;SUS 1&lt;/span&gt;&lt;/td&gt;&lt;td style=&#x27;padding:4px 0&#x27;&gt;Shared, managed serverless capacity instead of always-on instances.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#x27;vertical-align:top;padding:4px 6px 4px 0;white-space:nowrap&#x27;&gt;&lt;span style=&#x27;background:#2E7D32;color:#fff;font-weight:bold;border-radius:8px;padding:1px 6px;font-size:10px&#x27;&gt;SUS 2&lt;/span&gt;&lt;/td&gt;&lt;td style=&#x27;padding:4px 0&#x27;&gt;The smallest model that passes evaluation; unchanged documents are never re-embedded (content hash).&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#x27;vertical-align:top;padding:4px 6px 4px 0;white-space:nowrap&#x27;&gt;&lt;span style=&#x27;background:#2E7D32;color:#fff;font-weight:bold;border-radius:8px;padding:1px 6px;font-size:10px&#x27;&gt;SUS 3&lt;/span&gt;&lt;/td&gt;&lt;td style=&#x27;padding:4px 0&#x27;&gt;S3 lifecycle rules expire processed artefacts and move old versions to colder storage.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#AAB7B8;strokeColor=#2E7D32;align=left;verticalAlign=top;spacing=12;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="2216.7" y="2120.0" width="383.3333333333333" height="330" as="geometry"/></mxCell><mxCell id="e_u_cf" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#232F3E;strokeWidth=1.5;endArrow=block;endFill=1;endSize=5;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="users" target="cf"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_u_r53" value="DNS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#232F3E;strokeWidth=1.5;endArrow=block;endFill=1;endSize=5;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=0.75;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="users" target="r53"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="118" y="212"/></Array></mxGeometry></mxCell><mxCell id="e_u_cog" value="sign in (PKCE)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#232F3E;strokeWidth=1.5;endArrow=block;endFill=1;endSize=5;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=0.25;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="users" target="cognito"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="86" y="78"/><mxPoint x="932" y="78"/></Array></mxGeometry></mxCell><mxCell id="e_cf_site" value="OAC" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#232F3E;strokeWidth=1.5;endArrow=block;endFill=1;endSize=5;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cf" target="site"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="512" y="346"/><mxPoint x="512" y="211"/></Array></mxGeometry></mxCell><mxCell id="e_cf_api" value="/api/* · stream" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#232F3E;strokeWidth=1.5;endArrow=block;endFill=1;endSize=5;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cf" target="apigw"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_api_cog" value="verify JWT" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#232F3E;strokeWidth=1.5;endArrow=block;endFill=1;endSize=5;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="apigw" target="cognito"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="792" y="212"/></Array></mxGeometry></mxCell><mxCell id="e_api_q" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#232F3E;strokeWidth=1.5;endArrow=block;endFill=1;endSize=5;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="apigw" target="qfna"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="792" y="452"/><mxPoint x="856" y="452"/></Array></mxGeometry></mxCell><mxCell id="e_q_vpcea" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#232F3E;strokeWidth=1.5;endArrow=block;endFill=1;endSize=5;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=